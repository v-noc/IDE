# .env.example
APP_ENV=development
TERMINUS_HOST=http://localhost:6363
TERMINUS_DB=v_noc
TERMINUS_USER=admin
TERMINUS_KEY=root
TERMINUS_TEAM=admin

# TerminusDB Docker admin password (must match TERMINUS_KEY for API auth)
TERMINUSDB_ADMIN_PASS=root

PORT=8000

# Optional: language LSP JSON-RPC base URLs (paths use /rpc)
# VNOC_LSP_PYTHON_URL=http://127.0.0.1:9100
# VNOC_LSP_TS_JS_URL=http://127.0.0.1:9200

# --- Walkthrough agent (AI-guided code tours) ---
# One knob: provider[:model]. Provider only → that provider's default model.
#   fake                  — deterministic output, no API key (default)
#   openai:gpt-4o-mini    — OpenAI chat completions
#   vercel:zai/glm-4.7    — Vercel AI Gateway
#   custom:llama3:8b      — any OpenAI-compatible endpoint (set CUSTOM_LLM_* below)
WALKTHROUGH_LLM=fake

# OpenAI — Vectorlink embeddings (compose maps this to OPENAI_KEY) and walkthrough
# when WALKTHROUGH_LLM=openai:...
# OPENAI_API_KEY=sk-...

# Vercel AI Gateway — when WALKTHROUGH_LLM=vercel:...
# AI_GATEWAY_API_KEY=

# OpenAI-compatible custom endpoint — when WALKTHROUGH_LLM=custom:...
# CUSTOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CUSTOM_LLM_API_KEY=ollama

# Optional LangSmith tracing for the LangGraph walkthrough pipeline
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=v-noc-walkthrough
